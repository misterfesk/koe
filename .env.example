# Copy to .env.local and fill in. .env.local is git-ignored; this file is not, so keep it value-free.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
DATABASE_URL=file:./.data/pglite

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Model routing (optional; defaults are NVIDIA Nemotron on Nebius Token Factory)
# KOE_CHAT_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# KOE_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# KOE_SAFETY_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# KOE_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# AI calls per person per UTC day (searches count), and the AI kill switch
# KOE_AI_DAILY_CALLS=200
# KOE_AI=on
# Whole-site caps per UTC day, all people together (defaults 2000 and 300)
# KOE_SITE_DAILY_AI_CALLS=2000
# KOE_SITE_DAILY_SEARCHES=300

# Web search (Tavily). KOE_SEARCH=off disables it; without a key it is unavailable.
KOE_SEARCH=on
TAVILY_API_KEY=
# Local tests only; exact http://localhost or http://127.0.0.1 APP_URL required.
# KOE_SEARCH_STUB=on
